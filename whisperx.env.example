# Enable the durable background worker and automatically queue existing audio.
WHISPERX_ENABLED=true
WHISPERX_AUTO_BACKFILL=true
WHISPERX_LANGUAGE=en

# Safe defaults for the existing CPU server. Use large-v3, cuda and float16 on a GPU worker.
WHISPERX_MODEL=small.en
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_BATCH_SIZE=4
WHISPERX_CPU_THREADS=1
WHISPERX_PYTHON=python3
# Used only for the dashboard's approximate completion time. Tune this after
# observing the server: 1.5 means about 90 minutes plus startup for 60 minutes of audio.
WHISPERX_ESTIMATED_REALTIME_FACTOR=1.5
WHISPERX_ESTIMATED_STARTUP_SECONDS=180

# Speaker labels are optional. Enabling them also requires a Hugging Face token.
WHISPERX_DIARIZE=false
WHISPERX_HF_TOKEN=
WHISPERX_MIN_SPEAKERS=2
WHISPERX_MAX_SPEAKERS=4

WHISPERX_POLL_INTERVAL_MS=15000
WHISPERX_JOB_TIMEOUT_MS=21600000
WHISPERX_DOWNLOAD_TIMEOUT_MS=1800000
WHISPERX_MAX_AUDIO_BYTES=1073741824
