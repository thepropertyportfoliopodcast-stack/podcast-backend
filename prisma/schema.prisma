generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        UserRole @default(ADMIN)
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Podcast {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique
  slug              String    @unique
  thumbnail         String
  name              String    @unique
  email             String
  description       String
  seoTitle          String?
  seoDescription    String?
  primaryKeyword    String?
  secondaryKeywords String?
  createdAt         DateTime  @default(now())
  author            String    @default("The Property Portfolio Podcast")
  cast              String[]
  isDeleted         Boolean   @default(false)
  language          String[]
  episodes          Episode[]
}

model Episode {
  id                  Int                  @id @default(autoincrement())
  uuid                String               @unique
  slug                String               @unique
  title               String
  description         String
  seoTitle            String?
  seoDescription      String?
  primaryKeyword      String?
  secondaryKeywords   String?
  duration            Int
  durationInSec       Int
  link                String?
  thumbnail           String
  homepageThumbnail   String?
  websiteThumbnail    String?
  mimefield           String
  size                BigInt?
  createdAt           DateTime             @default(now())
  podcastId           Int
  isDeleted           Boolean              @default(false)
  detail              String?
  spotifyLink         String?
  appleLink           String?
  timestamps          String?
  youtubeUrl          String?
  transcript          String?
  topicsCovered       String[]             @default([])
  reelLinks           String[]             @default([])
  hostSlugs           String[]             @default([])
  guestHostSlugs      String[]             @default([])
  isFeatured          Boolean              @default(false)
  relatedEpisodeUuids String[]             @default([])
  episodeNumber       Int?
  season              Int?
  topic               String?              @default("Financing")
  audio               String?
  audioSize           BigInt?
  audioStatus         String               @default("PENDING")
  heroPhones          HeroPhone[]
  DistributionStatus  DistributionStatus[]
  podcast             Podcast              @relation(fields: [podcastId], references: [id])
}

model Host {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique
  slug              String   @unique
  name              String   @unique
  designation       String
  shortBio          String
  bio               String
  image             String
  email             String?
  linkedinUrl       String?
  instagramUrl      String?
  seoTitle          String?
  seoDescription    String?
  primaryKeyword    String?
  secondaryKeywords String?
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  isGuestOnly       Boolean  @default(false)
  guestTag          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isGuestOnly, isActive, displayOrder], map: "Host_guest_active_order_idx")
}

model HeroPhone {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique
  title           String
  description     String?
  thumbnail       String
  shortVideo      String?
  youtubeShortUrl String?
  youtubeVideoUrl String
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  episodeId       Int?
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, displayOrder], map: "HeroPhone_active_order_idx")
  @@index([episodeId, isActive], map: "HeroPhone_episode_active_idx")
}

model Guide {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique
  title       String
  description String
  author      String   @default("The Property Portfolio Podcast")
  link        String
  language    String[]
  thumbnail   String
  isDeleted   Boolean  @default(false)
  downloads   Int      @default(0)
  pages       Int?
}

model subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model contact {
  id             Int       @id @default(autoincrement())
  email          String
  name           String
  message        String
  subject        String?
  kind           String    @default("ENQUIRY")
  source         String    @default("contact_page")
  sheetSyncedAt  DateTime?
  sheetSyncError String?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([kind, createdAt])
}

model DistributionStatus {
  id                 Int       @id @default(autoincrement())
  episodeId          Int
  spotifyStatus      String    @default("pending")
  appleStatus        String    @default("pending")
  spotifyEpisodeId   String?
  spotifyEpisodeLink String?
  appleEpisodeId     String?
  appleEpisodeLink   String?
  errorLogs          String?
  retryCount         Int       @default(0)
  lastAttemptAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  Episode            Episode   @relation(fields: [episodeId], references: [id])
}

model AnalyticsSession {
  id              String           @id
  visitorId       String
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  landingPage     String
  referrer        String?
  source          String?
  medium          String?
  campaign        String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  country         String?
  ipHash          String?
  events          AnalyticsEvent[]

  @@index([visitorId, firstSeenAt])
  @@index([lastSeenAt])
}

model AnalyticsEvent {
  id         Int              @id @default(autoincrement())
  eventId    String           @unique
  sessionId  String
  visitorId  String
  name       String
  path       String
  title      String?
  value      Float?
  metadata   Json?
  createdAt  DateTime         @default(now())
  isResolved Boolean          @default(false)
  resolvedAt DateTime?
  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([name, isResolved, createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
  @@index([visitorId, createdAt])
}
